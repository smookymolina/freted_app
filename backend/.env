# ======================================
# Configuración Base de Datos MongoDB
# ======================================
MONGO_URI=mongodb://localhost:27017/nombre_db
# Formato alternativo si necesitas autenticación:
# MONGO_URI=mongodb://usuario:contraseña@localhost:27017/freted_app?authSource=admin

# ======================================
# Configuración JWT (Autenticación)
# ======================================
JWT_SECRET=tu_clave_secreta_compleja_aqui_123!@#  # Mínimo 32 caracteres
JWT_EXPIRE=1h                                     # 1h, 24h, 15m, etc.
JWT_COOKIE_EXPIRE=7                               # Días de duración de la cookie

# ======================================
# Configuración Servidor
# ======================================
PORT=5000
NODE_ENV=development                              # development|production

# ======================================
# Configuración Frontend (CORS)
# ======================================
FRONTEND_URL=http://localhost:5500
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:3000

# ======================================
# Configuración Email (Opcional)
# ======================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_contraseña_de_app_gmail
EMAIL_FROM=no-reply@freted.com

# ======================================
# Configuración Seguridad Adicional
# ======================================
RATE_LIMIT_WINDOW_MS=15*60*1000                   # 15 minutos
RATE_LIMIT_MAX=100                                # 100 peticiones por IP